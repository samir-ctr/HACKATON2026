@{
    ViewData["Title"] = "Inicio";
}


<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-container">


        <!-- TEXTO -->

        <div class="hero-content">

            <span class="hero-small-title">
                ENTRE MANOS
            </span>

            <h1>
                Conectamos manos,
                <br>
                <span>creamos futuro.</span>
            </h1>

            <p class="hero-description">

                Entre Manos es la plataforma que conecta
                proveedores de materias primas e insumos
                con artesanos como tú.

            </p>


            <div class="hero-buttons">

                <a href="#catalogo"
                   class="btn-primary">

                    Explorar catálogo
                    <span>→</span>

                </a>

                <a href="#quienes-somos"
                   class="btn-secondary">

                    Conocer más

                </a>

            </div>

        </div>


        <!-- IMAGEN -->

        <div class="hero-image-container">

            <div class="hero-decoration"></div>

            <img src="~/images/hero-artesanos.jpg"
                 alt="Artesano trabajando"
                 class="hero-image">

            <div class="hero-badge">

                <span>✦</span>

                <div>

                    <strong>
                        Hecho a mano
                    </strong>

                    <small>
                        Con dedicación y pasión
                    </small>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- ================= QUIENES SOMOS ================= -->

<section id="quienes-somos"
         class="about-section">

    <div class="section-title">

        <span>
            NUESTRA HISTORIA
        </span>

        <h2>
            Quiénes somos
        </h2>

        <p>
            Artesanía que conecta, comunidad que transforma.
        </p>

    </div>


    <div class="about-container">


        <!-- MISIÓN -->

        <article class="about-card">

            <div class="about-icon">
                ✋
            </div>

            <h3>
                Nuestra misión
            </h3>

            <p>

                Conectar a artesanos con proveedores
                de materiales e insumos de calidad,
                facilitando el acceso a productos que
                permitan crear piezas únicas.

            </p>

        </article>


        <!-- COMUNIDAD -->

        <article class="about-card featured">

            <div class="about-icon">
                ♡
            </div>

            <h3>
                Nuestra comunidad
            </h3>

            <p>

                Creamos un espacio donde artesanos,
                proveedores y compradores pueden
                encontrarse, colaborar y crecer juntos.

            </p>

        </article>


        <!-- COMPROMISO -->

        <article class="about-card">

            <div class="about-icon">
                ✦
            </div>

            <h3>
                Nuestro compromiso
            </h3>

            <p>

                Promovemos productos de calidad,
                comercio responsable y el valor
                de cada pieza elaborada artesanalmente.

            </p>

        </article>

    </div>

</section>



<!-- ================= PROPÓSITO ================= -->

<section class="purpose-section">

    <div class="purpose-container">

        <div class="purpose-text">

            <span>
                NUESTRA ESENCIA
            </span>

            <h2>
                Cada creación
                <br>
                cuenta una historia.
            </h2>

            <p>

                En Entre Manos creemos que detrás de
                cada producto artesanal existe una persona,
                una tradición y una historia que merece ser
                conocida.

            </p>

            <a href="#catalogo"
               class="btn-primary">

                Descubrir productos
                <span>→</span>

            </a>

        </div>


        <div class="purpose-quote">

            <div class="quote-mark">
                “
            </div>

            <p>

                Hecho a mano.
                <br>
                Hecho con amor.
                <br>
                Hecho para ti.

            </p>

        </div>

    </div>

</section>



<!-- ================= CATALOGO PREVIEW ================= -->

<section id="catalogo"
         class="catalog-section">

    <div class="section-title">

        <span>
            DESCUBRE
        </span>

        <h2>
            Nuestro catálogo
        </h2>

        <p>
            Encuentra materiales, insumos y productos
            para tus próximas creaciones.
        </p>

    </div>


    <div class="catalog-message">

        <div class="catalog-icon">
            ✦
        </div>

        <h3>
            Próximamente
        </h3>

        <p>
            Estamos preparando nuestro catálogo
            de productos para ti.
        </p>

    </div>

</section>