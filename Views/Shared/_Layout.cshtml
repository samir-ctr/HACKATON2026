<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Entre Manos</title>

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <!-- BARRA SUPERIOR -->
    <header class="navbar">

        <div class="navbar-container">

            <!-- LOGO ENTRE MANOS -->
            <a asp-controller="Home"
               asp-action="Index"
               class="logo-container">

                <img src="~/images/logo.png"
                     alt="Entre Manos"
                     class="logo">

            </a>

            <!-- MENÚ -->
            <nav class="menu">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="menu-link active">

                    Inicio

                </a>

                <a href="#quienes-somos"
                   class="menu-link">

                    Quiénes somos

                </a>

                <a href="#catalogo"
                   class="menu-link">

                    Catálogo

                </a>

            </nav>


            <!-- BUSCADOR -->
            <div class="search-box">

                <span class="search-icon">⌕</span>

                <input type="text"
                       placeholder="Buscar productos, materiales..." />

                <span class="search-config">⚙</span>

            </div>


            <!-- LOGIN -->
            <a asp-controller="Account"
               asp-action="Login"
               class="login-button">

                Iniciar sesión

                <span>♙</span>

            </a>

        </div>

    </header>


    <!-- CONTENIDO -->
    <main>

        @RenderBody()

    </main>


    <!-- FOOTER -->
    <footer class="footer">

        <div>

            <strong>entre manos</strong>

            <p>
                Artesanía que conecta, comunidad que transforma.
            </p>

        </div>

        <div>

            <p>
                © 2026 Entre Manos
            </p>

        </div>

    </footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>